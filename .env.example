# ============================================================================
# GRIYO — variables de entorno
# ----------------------------------------------------------------------------
# Copia este archivo a .env.local y completa las que tengas.
# IMPORTANTE: el proyecto funciona SIN NINGUNA de estas variables cargadas —
# cada servicio cae automáticamente a un "modo mock" realista para que puedas
# probar toda la app gratis. A medida que vayas pegando keys reales acá,
# cada función pasa a usar la API real sin que haya que tocar código.
# ============================================================================

# --- Anthropic Claude (conversación + tool use) ---------------------------
# Se usa como el "cerebro" de Griyo: decide qué responder y cuándo llamar a
# las tools (crear_recordatorio, guardar_memoria, buscar_memorias, etc).
# Conséguela en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Modelo a usar (opcional, tiene default razonable si lo dejas vacío)
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- OpenAI (Whisper STT + embeddings) -------------------------------------
# Whisper transcribe audio a texto (alternativa a la Web Speech API del
# navegador, que ya funciona sin key). text-embedding-3-small se usa para
# indexar las memorias en Pinecone.
# Conséguela en: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- ElevenLabs (texto → voz) ----------------------------------------------
# Da la voz cálida real de Griyo. Sin esta key, se usa la síntesis de voz
# nativa del navegador (funciona, pero suena más robótica).
# Conséguela en: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# ID de la voz a usar (opcional). IMPORTANTE: las voces de la Voice Library
# (comunidad) tiran 402 "paid_plan_required" por API en cuentas free — hace
# falta al menos el plan Starter de ElevenLabs (pestaña "ElevenCreative" en
# Suscripción) para usarlas. En cuentas free sin upgrade, usa una voz
# "premade" (las que trae la cuenta por defecto, categoría "premade" en
# GET /v1/voices).
ELEVENLABS_VOICE_ID=

# --- Pinecone (memoria vectorial para RAG de historias) --------------------
# Guarda embeddings de cada "memoria" capturada para poder buscarlas por
# similitud semántica desde la vista familiar. Sin esta key, se usa un
# archivo JSON local (/data/vectorstore.json) con similitud coseno.
# Conséguela en: https://app.pinecone.io/ (plan Starter gratuito alcanza)
PINECONE_API_KEY=
# Nombre del índice ya creado en tu cuenta de Pinecone. La dimensión del
# índice tiene que coincidir con MOCK_DIM en src/lib/ai/embeddings.ts
# (1024 por defecto, para funcionar sin OPENAI_API_KEY). Si más adelante
# sumas OPENAI_API_KEY, recrea el índice en 1536 (text-embedding-3-small) o
# ajusta MOCK_DIM para que ambos coincidan.
PINECONE_INDEX=grillo-memorias

# --- OpenWeatherMap (clima) -------------------------------------------------
# Para que Griyo pueda charlar sobre el clima del día. Sin esta key, devuelve
# un dato de clima simulado aleatorio.
# Conséguela en: https://home.openweathermap.org/api_keys (free tier)
OPENWEATHER_API_KEY=

# --- Resend (email de la alerta de emergencia) ------------------------------
# Cuando la persona mayor toca "Necesito ayuda", además de guardar la alerta
# (que la familia ve en su panel) se le manda un correo a cada familiar
# vinculado. Sin esta key, el envío queda en modo mock (solo se loguea en la
# consola del servidor) — la alerta se sigue guardando igual, simplemente no
# sale el correo real.
# Conséguela en: https://resend.com/api-keys (free tier: 3000 emails/mes)
RESEND_API_KEY=
# Remitente que va a aparecer en el correo (opcional). Sin dominio propio
# verificado en Resend, usa el default de pruebas "onboarding@resend.dev".
RESEND_FROM_EMAIL=

# --- WhatsApp vía Twilio (recuperar contraseña + avisos a la familia) -------
# Las cuentas se crean con número de WhatsApp (el correo es opcional), así que
# el link de recuperación y las alertas (emergencia, ánimo, inactividad) salen
# por WhatsApp. Sin estas tres variables no se manda nada: queda logueado
# (mock) y la app sigue funcionando.
# Conséguelas en: https://console.twilio.com (Messaging > Try it out > WhatsApp
# para el sandbox; para producción, un remitente de WhatsApp aprobado).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Remitente en formato whatsapp:+14155238886 (ese es el del sandbox)
TWILIO_WHATSAPP_FROM=
# WhatsApp solo deja escribirle a alguien que no te escribió antes (o hace más
# de 24 h) con una plantilla aprobada. Crea las plantillas en Twilio (Content
# Template Builder) y pon aquí sus Content SID (HX...). Sin plantilla se manda
# texto libre: sirve en el sandbox, no en producción.
# {{1}} = link | {{1}} = nombre, {{2}} = hora | {{1}} = nombre, {{2}} = resumen |
# {{1}} = nombre, {{2}} = días sin charlar
TWILIO_WHATSAPP_CONTENT_SID_RECUPERACION=
TWILIO_WHATSAPP_CONTENT_SID_EMERGENCIA=
TWILIO_WHATSAPP_CONTENT_SID_ANIMO=
TWILIO_WHATSAPP_CONTENT_SID_INACTIVIDAD=

# --- Supabase (base de datos + login real) ----------------------------------
# Guarda usuarios, abuelos, recordatorios y metadata de memorias en Postgres,
# y es lo que hace andar el login real (Supabase Auth) — el familiar se
# registra con email/contraseña, y cada familia solo ve sus propios datos
# (políticas RLS, ver supabase/schema.sql). REQUERIDO para el login: sin
# estas variables, /registro y /login no funcionan (el resto de la app sigue
# andando en modo mock con un store local en /data/db.json).
# Consíguelas en: https://app.supabase.com/project/_/settings/api
# Corre supabase/schema.sql en el SQL editor del proyecto antes de usarlas.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Notificaciones push (recordatorios) -------------------------------------
# Sin esto, los recordatorios solo se avisan si la app está abierta en
# pantalla en ese momento (ver RecordatoriosPanel.tsx). Con esto, llegan como
# notificación del sistema aunque el navegador esté cerrado.
# Generar el par con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Secreto propio (cualquier string largo) que debe mandar quien dispare
# /api/push/enviar-pendientes — ver PROGRESO.md para cómo programar esto con
# un cron externo gratuito, ya que Vercel Hobby no permite crons más
# frecuentes que 1 vez al día.
CRON_SECRET=

# --- Panel de administración (/admin) ----------------------------------------
# Correos (separados por coma) de las cuentas que pueden entrar a /admin y ver
# el uso, las familias y las suscripciones. Tienen que ser cuentas ya
# registradas en Griyo con el email confirmado. Si queda vacío, /admin queda
# deshabilitado para todos.
ADMIN_EMAILS=

# --- Aviso diario, privacidad y avisos a la familia ---------------------------
# Correo de contacto que aparece en la política de privacidad y los términos.
NEXT_PUBLIC_CONTACTO_EMAIL=
# URL pública de la app (se usa en los correos). Por defecto https://griyo.cl
NEXT_PUBLIC_APP_URL=
# "true" para que Griyo le escriba a la familia cuando la persona mayor lleva 3
# o más días sin conversar (una vez al día, a las 12:00, máximo cada 72 horas).
# Apagado por defecto.
AVISOS_FAMILIA_ACTIVOS=false
